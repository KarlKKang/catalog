{
  "name": "catalog",
  "version": "1.3.0",
  "description": "Front-end of featherine.com",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build:font": "python3 build_font.py",
    "build": "bash build.sh production",
    "build:alpha": "bash build.sh alpha",
    "build:beta": "bash build.sh beta",
    "build:hls.js": "bash build_hls.sh",
    "build-init": "bash build_init.sh",
    "lint": "npx eslint src/script/",
    "lint:fix": "npm run lint -- --fix",
    "publish": "bash publish.sh featherine-website ./dist/",
    "publish:dev": "bash publish.sh featherine-website-alpha ./dev/",
    "fetch-deployment": "bash fetch_deployment.sh featherine-website ./dist/",
    "fetch-deployment:dev": "bash fetch_deployment.sh featherine-website-alpha ./dev/",
    "check-circular": "madge --circular --warning src/script/entry/index.ts"
  },
  "author": "Kai Kang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarlKKang/catalog.git"
  },
  "bugs": {
    "url": "https://github.com/KarlKKang/catalog/issues"
  },
  "homepage": "https://github.com/KarlKKang/catalog",
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/plugin-transform-runtime": "7.29.0",
    "@babel/preset-env": "7.29.2",
    "@babel/runtime": "7.29.2",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/eslint__js": "8.42.3",
    "@types/qrcode": "1.5.6",
    "@types/ua-parser-js": "0.7.39",
    "babel-loader": "10.1.1",
    "core-js": "3.49.0",
    "css-loader": "7.1.4",
    "css-minimizer-webpack-plugin": "8.0.0",
    "cssnano": "7.1.3",
    "cssnano-preset-advanced": "7.0.11",
    "ejs-loader": "0.5.0",
    "eslint": "10.0.3",
    "favicons-webpack-plugin": "6.0.1",
    "globals": "17.4.0",
    "html-loader": "5.1.0",
    "html-minifier-terser": "7.2.0",
    "html-webpack-plugin": "5.6.6",
    "isbot": "5.1.36",
    "madge": "8.0.0",
    "mini-css-extract-plugin": "2.10.1",
    "postcss": "8.5.8",
    "qrcode": "1.5.4",
    "sass": "1.98.0",
    "sass-loader": "16.0.7",
    "screenfull": "6.0.2",
    "source-map-loader": "5.0.0",
    "terser-webpack-plugin": "5.4.0",
    "ts-loader": "9.5.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "typescript-plugin-css-modules": "5.2.0",
    "ua-parser-js": "1.0.41",
    "webp-hero": "0.0.2",
    "webpack": "5.105.4",
